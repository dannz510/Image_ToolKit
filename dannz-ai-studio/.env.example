# Dannz AI Studio - environment configuration
#
# Copy to `.env.local` for Vite, or set these in the Vercel project settings.
# Everything is optional: the app runs with secure defaults and no config.

# ---------------------------------------------------------------------------
# API (api/*.py)
# ---------------------------------------------------------------------------

# Comma-separated list of origins allowed to call the API cross-origin.
# Empty (default) => same-origin only; no CORS header is emitted at all.
# Example: ALLOWED_ORIGINS="https://studio.example.com,https://preview.example.com"
# ALLOWED_ORIGINS=

# Convenience switch for local development. When "1", the localhost Vite dev
# server origins (127.0.0.1/localhost on :3000 and :4173) are allowlisted.
# DANNZ_DEV=1

# Enable the large ONNX models (u2net, isnet-*). Off by default so a public
# instance cannot be forced into 100+ MB cold starts.
# ALLOW_HEAVY_MODELS=0

# Hard cap on request body size in bytes (default 4718592 ~= 4.5 MB).
# MAX_BODY_BYTES=4718592

# How many images may run inference concurrently on one instance.
# MAX_CONCURRENCY=1

# Seconds to wait for the single inference slot before returning 429.
# INFERENCE_TIMEOUT=25

# Local API bind address. Defaults to 127.0.0.1 (loopback). Set 0.0.0.0 only
# when you deliberately expose the dev API on your LAN - it has no auth.
# HOST=127.0.0.1

# Local API port (default 8000).
# PORT=8000
